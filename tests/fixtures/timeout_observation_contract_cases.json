{
  "description": "Hand-authored timeout_observation contract cases for doctor_run_directory.validate_quality_eval_artifact. Each case supplies a full timeout object and the structured '.timeout.' validation errors expected from it. 'accepted' means the observation contract itself raises no '.timeout.' schema error; a legacy absent observation is accepted at the observation boundary even though the non-success status is still rejected. These cases are written by hand and never generated by calling the producer.",
  "base_status": "quality_eval_timeout",
  "cases": [
    {
      "name": "client_timeout_unknown_accepted",
      "note": "Client-side subprocess timeout: statement outcome must stay unknown.",
      "timeout": {
        "stage": "query",
        "reason": "client subprocess timeout",
        "limit_seconds": 5.0,
        "completed_results": 0,
        "partial_result_preserved": false,
        "partial_result_count": 0,
        "client_side_only": true,
        "timeout_observation": {
          "statement_outcome": "unknown",
          "backend_state_after_timeout": "unobserved",
          "cancellation_completion": "unverified",
          "transaction_cleanup": "unverified"
        }
      },
      "accepted": true,
      "expected_errors": []
    },
    {
      "name": "server_timeout_reported_accepted",
      "note": "Confirmed server statement timeout with all four observation fields.",
      "timeout": {
        "stage": "query",
        "reason": "server statement timeout",
        "limit_seconds": 5.0,
        "completed_results": 0,
        "partial_result_preserved": false,
        "partial_result_count": 0,
        "client_side_only": false,
        "timeout_source": "server_statement",
        "requested_statement_timeout_ms": 5000,
        "effective_statement_timeout_ms": 5000,
        "sqlstate": "57014",
        "timeout_observation": {
          "statement_outcome": "server_statement_timeout_reported",
          "backend_state_after_timeout": "unobserved",
          "cancellation_completion": "unverified",
          "transaction_cleanup": "unverified"
        }
      },
      "accepted": true,
      "expected_errors": []
    },
    {
      "name": "legacy_absence_accepted_client",
      "note": "Legacy client timeout without an observation key stays accepted at the observation boundary.",
      "timeout": {
        "stage": "query",
        "reason": "client subprocess timeout",
        "limit_seconds": 5.0,
        "completed_results": 0,
        "partial_result_preserved": false,
        "partial_result_count": 0,
        "client_side_only": true
      },
      "accepted": true,
      "expected_errors": []
    },
    {
      "name": "legacy_absence_server_rejected",
      "note": "A server timeout must record the confirmed statement outcome.",
      "timeout": {
        "stage": "query",
        "reason": "server statement timeout",
        "limit_seconds": 5.0,
        "completed_results": 0,
        "partial_result_preserved": false,
        "partial_result_count": 0,
        "client_side_only": false,
        "timeout_source": "server_statement",
        "requested_statement_timeout_ms": 5000,
        "effective_statement_timeout_ms": 5000,
        "sqlstate": "57014"
      },
      "accepted": false,
      "expected_errors": [
        "quality.json.timeout.timeout_observation.statement_outcome must be 'server_statement_timeout_reported' when client_side_only=false"
      ]
    },
    {
      "name": "explicit_null_observation_rejected",
