	python3 tools/bench_lance.py --rows $(BENCH_ROWS) --dim $(BENCH_DIM) --batch-size $(BENCH_BATCH) $(BENCH_LANCE_OUTPUTS)

bench-warc:
	python3 tools/bench_warc.py --rows $(WARC_ROWS) --body-words $(WARC_WORDS) --vector-dim $(BENCH_DIM) --batch-size $(BENCH_BATCH) --bm25-mode $(WARC_BM25_MODE) $(BENCH_WARC_OUTPUTS)

bench-warc-bm25-modes:
	python3 tools/bench_warc_bm25_modes.py --rows $(WARC_COMPARE_ROWS) --body-words $(WARC_WORDS) --vector-dim $(BENCH_DIM) --batch-size $(BENCH_BATCH) $(WARC_COMPARE_EXECUTE_ARG) $(WARC_COMPARE_NO_HASH_VECTORS_ARG) $(BENCH_WARC_BM25_OUTPUTS)

finalize-benchmark-comparison-run:
	test -n "$(RUN_DIR)"
	test -n "$(BENCHMARK_BASELINE_JSON)"
	test -n "$(BENCHMARK_CANDIDATE_JSON)"
	test -n "$(BENCHMARK_MAX_REGRESSION_RATIO)"
