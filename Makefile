	$(MAKE) finalize-run-directory RUN_DIR="$(RUN_DIR)" RUN_METADATA_COMMAND="$(QUALITY_BUILD_RUN_METADATA_COMMAND)" RUN_METADATA_ENV="$(RUN_METADATA_ENV)" RUN_METADATA_JSON="$(RUN_METADATA_JSON)" RUN_METADATA_MARKDOWN="$(RUN_METADATA_MARKDOWN)" RUN_DOCTOR_PROFILE=generic RUN_DOCTOR_REQUIRE="$(strip $(QUALITY_BUILD_RUN_DOCTOR_REQUIRE) $(RUN_DOCTOR_REQUIRE))" RUN_DOCTOR_JSON="$(RUN_DOCTOR_JSON)" RUN_DOCTOR_MARKDOWN="$(RUN_DOCTOR_MARKDOWN)" RUN_MANIFEST_JSON="$(RUN_MANIFEST_JSON)" RUN_MANIFEST_MARKDOWN="$(RUN_MANIFEST_MARKDOWN)"

make-quality-fixture:
	test -n "$(QUALITY_RECORDS_JSONL)"
	test -n "$(QUALITY_EMBEDDING_JSONL)"
	test -n "$(QUALITY_QUERIES_JSON)"
	python3 tools/make_quality_fixture.py --records-jsonl "$(QUALITY_RECORDS_JSONL)" --embedding-jsonl "$(QUALITY_EMBEDDING_JSONL)" --queries-json "$(QUALITY_QUERIES_JSON)" $(QUALITY_FIXTURE_NAME_ARG) --output "$(QUALITY_FIXTURE_OUTPUT)"

report-quality-fixture:
	python3 tools/report_quality_fixture.py $(QUALITY_FIXTURE_ARG) --min-docs "$(QUALITY_FIXTURE_MIN_DOCS)" --min-queries "$(QUALITY_FIXTURE_MIN_QUERIES)" $(QUALITY_FIXTURE_REPORT_PROVENANCE_ARGS) $(QUALITY_FIXTURE_REPORT_OUTPUTS)

doctor-quality-baseline:
	test -n "$(QUALITY_BASELINE_FIXTURE_REPORT_JSON)"
	test -n "$(QUALITY_BASELINE_QUALITY_JSON)"
	python3 tools/doctor_quality_baseline.py --fixture-report-json "$(QUALITY_BASELINE_FIXTURE_REPORT_JSON)" --quality-json "$(QUALITY_BASELINE_QUALITY_JSON)" --min-docs "$(QUALITY_BASELINE_MIN_DOCS)" --min-queries "$(QUALITY_BASELINE_MIN_QUERIES)" --min-expected-labels "$(QUALITY_BASELINE_MIN_EXPECTED_LABELS)" --min-hit-rate "$(QUALITY_BASELINE_MIN_HIT_RATE)" --min-mrr "$(QUALITY_BASELINE_MIN_MRR)" $(QUALITY_BASELINE_REAL_CORPUS_ARG) $(QUALITY_BASELINE_DOCTOR_OUTPUTS)

stage-quality-provenance:
	if test -n "$(QUALITY_PROVENANCE_JSON)"; then \
		test -n "$(QUALITY_RUN_PROVENANCE_JSON)"; \
		test -f "$(QUALITY_PROVENANCE_JSON)"; \
		mkdir -p "$$(dirname "$(QUALITY_RUN_PROVENANCE_JSON)")"; \
		if test -e "$(QUALITY_RUN_PROVENANCE_JSON)" && test "$(QUALITY_PROVENANCE_JSON)" -ef "$(QUALITY_RUN_PROVENANCE_JSON)"; then \
			:; \
		else \
			cp "$(QUALITY_PROVENANCE_JSON)" "$(QUALITY_RUN_PROVENANCE_JSON)"; \
		fi; \
	fi

quality-finalization-preflight:
	if test -z "$(QUALITY_INPUT_PREFLIGHT_GATE)"; then \
		:; \
	else \
		$(MAKE) preflight-quality-inputs \
			QUALITY_INPUT_PREFLIGHT_CORPUS="$(QUALITY_INPUT_PREFLIGHT_CORPUS)" \
			QUALITY_INPUT_PREFLIGHT_QUERIES_JSON="$(QUALITY_INPUT_PREFLIGHT_QUERIES_JSON)" \
			QUALITY_INPUT_PREFLIGHT_QRELS_JSON="$(QUALITY_INPUT_PREFLIGHT_QRELS_JSON)" \
			QUALITY_INPUT_PREFLIGHT_RECORDS_JSONL="$(QUALITY_INPUT_PREFLIGHT_RECORDS_JSONL)" \
			QUALITY_INPUT_PREFLIGHT_PROVENANCE_JSON="$(QUALITY_INPUT_PREFLIGHT_PROVENANCE_JSON)" \
			QUALITY_INPUT_PREFLIGHT_MANIFEST_JSON="$(QUALITY_INPUT_PREFLIGHT_MANIFEST_JSON)" \
			QUALITY_INPUT_PREFLIGHT_JSON="$(QUALITY_INPUT_PREFLIGHT_JSON)" \
			QUALITY_INPUT_PREFLIGHT_MARKDOWN="$(QUALITY_INPUT_PREFLIGHT_MARKDOWN)"; \
	fi

finalize-quality-run:
	test -n "$(RUN_DIR)"
	mkdir -p "$(RUN_DIR)"
	$(MAKE) quality-finalization-preflight
	$(MAKE) stage-quality-provenance QUALITY_PROVENANCE_JSON="$(QUALITY_PROVENANCE_JSON)" QUALITY_RUN_PROVENANCE_JSON="$(QUALITY_RUN_PROVENANCE_JSON)"
	$(MAKE) report-quality-fixture QUALITY_FIXTURE="$(QUALITY_FIXTURE)" QUALITY_PROVENANCE_JSON="$(QUALITY_REPORT_PROVENANCE_JSON)" QUALITY_MIN_SOURCE_DOCS="$(QUALITY_MIN_SOURCE_DOCS)" QUALITY_MAX_SOURCE_SKIPPED_RATIO="$(QUALITY_MAX_SOURCE_SKIPPED_RATIO)" QUALITY_FIXTURE_MIN_DOCS="$(QUALITY_FIXTURE_MIN_DOCS)" QUALITY_FIXTURE_MIN_QUERIES="$(QUALITY_FIXTURE_MIN_QUERIES)" QUALITY_FIXTURE_REPORT_JSON="$(QUALITY_RUN_FIXTURE_REPORT_JSON)" QUALITY_FIXTURE_REPORT_MARKDOWN="$(QUALITY_RUN_FIXTURE_REPORT_MARKDOWN)"
	$(MAKE) eval-quality QUALITY_FIXTURE="$(QUALITY_FIXTURE)" QUALITY_JSON="$(QUALITY_RUN_JSON)" QUALITY_MARKDOWN="$(QUALITY_RUN_MARKDOWN)" QUERY_STATEMENT_TIMEOUT_SECONDS="$(QUERY_STATEMENT_TIMEOUT_SECONDS)"
	$(MAKE) doctor-quality-baseline RUN_DIR="$(RUN_DIR)" QUALITY_BASELINE_FIXTURE_REPORT_JSON="$(QUALITY_RUN_FIXTURE_REPORT_JSON)" QUALITY_BASELINE_QUALITY_JSON="$(QUALITY_RUN_JSON)" QUALITY_BASELINE_REQUIRE_REAL_CORPUS="$(QUALITY_BASELINE_REQUIRE_REAL_CORPUS)"
	$(MAKE) finalize-run-directory RUN_DIR="$(RUN_DIR)" RUN_METADATA_COMMAND="$(QUALITY_RUN_METADATA_COMMAND)" RUN_METADATA_ENV="$(RUN_METADATA_ENV)" RUN_METADATA_JSON="$(RUN_METADATA_JSON)" RUN_METADATA_MARKDOWN="$(RUN_METADATA_MARKDOWN)" RUN_DOCTOR_PROFILE=quality RUN_DOCTOR_REQUIRE="$(strip $(QUALITY_RUN_DOCTOR_REQUIRE) $(QUALITY_RUN_PROVENANCE_REQUIRE) $(RUN_DOCTOR_REQUIRE))" RUN_DOCTOR_JSON="$(RUN_DOCTOR_JSON)" RUN_DOCTOR_MARKDOWN="$(RUN_DOCTOR_MARKDOWN)" RUN_MANIFEST_JSON="$(RUN_MANIFEST_JSON)" RUN_MANIFEST_MARKDOWN="$(RUN_MANIFEST_MARKDOWN)"

