	$(MAKE) finalize-run-directory RUN_DIR="$(RUN_DIR)" RUN_METADATA_COMMAND="$(BENCHMARK_COMPARE_RUN_METADATA_COMMAND)" RUN_METADATA_ENV="$(RUN_METADATA_ENV)" RUN_METADATA_JSON="$(RUN_METADATA_JSON)" RUN_METADATA_MARKDOWN="$(RUN_METADATA_MARKDOWN)" RUN_DOCTOR_PROFILE=benchmark RUN_DOCTOR_REQUIRE="$(strip $(BENCHMARK_COMPARE_RUN_DOCTOR_REQUIRE) $(RUN_DOCTOR_REQUIRE))" RUN_DOCTOR_JSON="$(RUN_DOCTOR_JSON)" RUN_DOCTOR_MARKDOWN="$(RUN_DOCTOR_MARKDOWN)" RUN_MANIFEST_JSON="$(RUN_MANIFEST_JSON)" RUN_MANIFEST_MARKDOWN="$(RUN_MANIFEST_MARKDOWN)"

