QUALITY_ATTEMPT_IDENTITY_OUTPUTS = $(if $(QUALITY_ATTEMPT_IDENTITY_DOCTOR_JSON),--json-output $(QUALITY_ATTEMPT_IDENTITY_DOCTOR_JSON),) $(if $(QUALITY_ATTEMPT_IDENTITY_DOCTOR_MARKDOWN),--markdown-output $(QUALITY_ATTEMPT_IDENTITY_DOCTOR_MARKDOWN),)
UPGRADE_INPUT_DOCTOR_OUTPUTS = $(if $(UPGRADE_INPUT_DOCTOR_JSON),--json-output $(UPGRADE_INPUT_DOCTOR_JSON),) $(if $(UPGRADE_INPUT_DOCTOR_MARKDOWN),--markdown-output $(UPGRADE_INPUT_DOCTOR_MARKDOWN),)
UPGRADE_INPUT_OLD_VERSION_ARG = $(if $(UPGRADE_OLD_VERSION),--old-version "$(UPGRADE_OLD_VERSION)",)
UPGRADE_INPUT_OLD_DIST_DIR_ARG = $(if $(UPGRADE_OLD_DIST_DIR),--old-dist-dir "$(UPGRADE_OLD_DIST_DIR)",)
UPGRADE_INPUT_NEW_DIST_DIR_ARG = $(if $(UPGRADE_NEW_DIST_DIR),--new-dist-dir "$(UPGRADE_NEW_DIST_DIR)",)
QUALITY_RUN_JSON = $(if $(QUALITY_JSON),$(QUALITY_JSON),$(if $(RUN_DIR),$(RUN_DIR)/quality.json,))
QUALITY_RUN_MARKDOWN = $(if $(QUALITY_MARKDOWN),$(QUALITY_MARKDOWN),$(if $(RUN_DIR),$(RUN_DIR)/quality.md,))
QUALITY_RUN_FIXTURE_REPORT_JSON = $(if $(QUALITY_FIXTURE_REPORT_JSON),$(QUALITY_FIXTURE_REPORT_JSON),$(if $(RUN_DIR),$(RUN_DIR)/quality_fixture_report.json,))
QUALITY_RUN_FIXTURE_REPORT_MARKDOWN = $(if $(QUALITY_FIXTURE_REPORT_MARKDOWN),$(QUALITY_FIXTURE_REPORT_MARKDOWN),$(if $(RUN_DIR),$(RUN_DIR)/quality_fixture_report.md,))
QUALITY_RUN_DOCTOR_REQUIRE ?= quality_baseline_doctor.json
ANALYSIS_MAX_ITERATIONS ?=
ANALYSIS_MAX_QUERIES ?=
ANALYSIS_DEADLINE_SECONDS ?=
ANALYSIS_BUDGET_STATUS_JSON ?= $(if $(BENCH_OUT_DIR),$(BENCH_OUT_DIR)/analysis_budget_status.json,)
ANALYSIS_BUDGET_STATUS_ARG = $(if $(ANALYSIS_BUDGET_STATUS_JSON),--budget-status-json "$(ANALYSIS_BUDGET_STATUS_JSON)",)
QUALITY_QUERY_TIMEOUT_SECONDS ?=
QUALITY_QUERY_TIMEOUT_ARG = $(if $(QUALITY_QUERY_TIMEOUT_SECONDS),--query-timeout-seconds "$(QUALITY_QUERY_TIMEOUT_SECONDS)",)
QUERY_STATEMENT_TIMEOUT_SECONDS ?=
QUERY_STATEMENT_TIMEOUT_ARG = $(if $(QUERY_STATEMENT_TIMEOUT_SECONDS),--query-statement-timeout-seconds "$(QUERY_STATEMENT_TIMEOUT_SECONDS)",)
QUALITY_FIXTURE_ARG = $(if $(QUALITY_FIXTURE),--fixture-json $(QUALITY_FIXTURE),)
QUALITY_FIXTURE_NAME_ARG = $(if $(QUALITY_FIXTURE_NAME),--name $(QUALITY_FIXTURE_NAME),)
PUBLIC_WARC_PATH_ARG = $(if $(PUBLIC_WARC_PATH),--warc-path "$(PUBLIC_WARC_PATH)",)
PUBLIC_WARC_SOURCE_SPEC_ARG = $(if $(PUBLIC_WARC_SOURCE_SPEC_JSON),--source-spec-json "$(PUBLIC_WARC_SOURCE_SPEC_JSON)",)
PUBLIC_WARC_QUERY_SPEC_ARG = $(if $(PUBLIC_WARC_QUERY_SPEC_JSON),--query-spec-json "$(PUBLIC_WARC_QUERY_SPEC_JSON)",)
PUBLIC_WARC_PROVENANCE_ARG = $(if $(PUBLIC_WARC_PROVENANCE_JSON),--manifest-json "$(PUBLIC_WARC_PROVENANCE_JSON)",)
PUBLIC_WARC_QUALITY_ARTIFACT_OUTPUTS = $(if $(PUBLIC_WARC_QUALITY_RECORDS_JSONL),--records-jsonl "$(PUBLIC_WARC_QUALITY_RECORDS_JSONL)",) $(if $(PUBLIC_WARC_QUALITY_EMBEDDING_JSONL),--embedding-jsonl "$(PUBLIC_WARC_QUALITY_EMBEDDING_JSONL)",) $(if $(PUBLIC_WARC_QUALITY_QUERIES_JSON),--queries-json "$(PUBLIC_WARC_QUALITY_QUERIES_JSON)",)
EXT_VERSION ?= $(shell awk -F'"' '/^version =/ {print $$2; exit}' Cargo.toml)
DIST_DIR ?= dist/pgwarc_lance-$(EXT_VERSION)-$(PG_FEATURE)
ARTIFACT_CONTAINER ?= pgwarc_lance_artifacts_$(PG_FEATURE)

build:
	PG_MAJOR=$(PG_MAJOR) DEV_PERMISSIONS=$(DEV_PERMISSIONS) docker compose build

rebuild:
	PG_MAJOR=$(PG_MAJOR) DEV_PERMISSIONS=$(DEV_PERMISSIONS) docker compose build --no-cache

up:
	docker compose up -d
	@echo "waiting for postgres to be healthy..."
	@timeout 60 bash -c 'until docker compose ps postgres | grep -q healthy; do sleep 2; done' || true
	@docker compose ps

down:
	docker compose down

restart:
	docker compose restart

logs:
	docker compose logs -f postgres

status:
	docker compose ps

psql:
	docker compose exec postgres psql -U pgwarc_lance -d pgwarc_lance_test

# smoke test: run tests/test.sql against the live container
test:
	docker compose exec -T postgres psql -U pgwarc_lance -d pgwarc_lance_test -v ON_ERROR_STOP=1 -c 'DROP EXTENSION IF EXISTS pgwarc_lance CASCADE; CREATE EXTENSION pgwarc_lance;'
	docker compose exec -T postgres psql -U pgwarc_lance -d pgwarc_lance_test -v ON_ERROR_STOP=1 < tests/test.sql

# unit test harness: compile the tokenizer module without linking the extension stack
test-unit:
	docker compose exec -T --user postgres postgres bash -lc 'export USER=postgres RUSTUP_HOME=/root/.rustup CARGO_HOME=/root/.cargo PATH="/root/.cargo/bin:$$PATH" && rustc --test /build/tests/unit_tokenizer.rs -o /tmp/pgwarc_lance_unit_tokenizer && /tmp/pgwarc_lance_unit_tokenizer'

test-warc:
	python3 -m unittest discover -s tests -p 'test_*.py'

test-warc-db:
	python3 tests/db_warc_importer.py

# regression test harness: pg_regress SQL tests in tests/pg_regress
test-regress:
	docker compose exec -T --user postgres postgres bash -lc 'set -euo pipefail; export USER=postgres RUSTUP_HOME=/root/.rustup CARGO_HOME=/root/.cargo PATH="/root/.cargo/bin:$$PATH"; cargo pgrx install --pg-config /usr/bin/pg_config; cargo pgrx stop pg16 || true; cargo pgrx start pg16; until pg_isready -h localhost -p 28816 >/dev/null; do sleep 1; done; dropdb -h localhost -p 28816 --if-exists pgwarc_lance_regress; createdb -h localhost -p 28816 pgwarc_lance_regress; rm -rf /tmp/pgwarc_lance_pg_regress; mkdir -p /tmp/pgwarc_lance_pg_regress; tests=$$(find /build/tests/pg_regress/sql -maxdepth 1 -type f -name "*.sql" ! -name "setup.sql" -printf "%f\n" | sed "s/\.sql$$//" | sort | tr "\n" " "); cd /build/tests/pg_regress && /usr/lib/postgresql/16/lib/pgxs/src/test/regress/pg_regress --host localhost --port 28816 --use-existing --dbname=pgwarc_lance_regress --inputdir=/build/tests/pg_regress --outputdir=/tmp/pgwarc_lance_pg_regress setup $$tests'

# all harnesses
test-all: test-unit test-uri-policy test-warc test-regress test test-warc-db test-runtime-safety test-backup-restore test-ingest-replay test-write-cancellation test-search-memory test-bm25-snapshot

check-docs:
	python3 tools/check_docs.py

verify: test-all eval-quality check-docs
	python3 -m py_compile tools/*.py tests/*.py
	git diff --check

bench: bench-bm25 bench-lance bench-warc

finalize-benchmark-run:
	test -n "$(RUN_DIR)"
	mkdir -p "$(RUN_DIR)"
	$(MAKE) bench BENCH_OUT_DIR="$(RUN_DIR)"
	$(MAKE) finalize-run-directory RUN_DIR="$(RUN_DIR)" RUN_METADATA_COMMAND="$(BENCH_RUN_METADATA_COMMAND)" RUN_METADATA_ENV="$(RUN_METADATA_ENV)" RUN_METADATA_JSON="$(RUN_METADATA_JSON)" RUN_METADATA_MARKDOWN="$(RUN_METADATA_MARKDOWN)" RUN_DOCTOR_PROFILE=benchmark RUN_DOCTOR_REQUIRE="$(strip $(BENCH_RUN_DOCTOR_REQUIRE) $(RUN_DOCTOR_REQUIRE))" RUN_DOCTOR_JSON="$(RUN_DOCTOR_JSON)" RUN_DOCTOR_MARKDOWN="$(RUN_DOCTOR_MARKDOWN)" RUN_MANIFEST_JSON="$(RUN_MANIFEST_JSON)" RUN_MANIFEST_MARKDOWN="$(RUN_MANIFEST_MARKDOWN)"

finalize-warc-bm25-modes-run:
	test -n "$(RUN_DIR)"
	mkdir -p "$(RUN_DIR)"
	$(MAKE) bench-warc-bm25-modes BENCH_OUT_DIR="$(RUN_DIR)"
	$(MAKE) finalize-run-directory RUN_DIR="$(RUN_DIR)" RUN_METADATA_COMMAND="$(WARC_BM25_MODES_RUN_METADATA_COMMAND)" RUN_METADATA_ENV="$(RUN_METADATA_ENV)" RUN_METADATA_JSON="$(RUN_METADATA_JSON)" RUN_METADATA_MARKDOWN="$(RUN_METADATA_MARKDOWN)" RUN_DOCTOR_PROFILE=benchmark RUN_DOCTOR_REQUIRE="$(strip $(WARC_BM25_MODES_RUN_DOCTOR_REQUIRE) $(RUN_DOCTOR_REQUIRE))" RUN_DOCTOR_JSON="$(RUN_DOCTOR_JSON)" RUN_DOCTOR_MARKDOWN="$(RUN_DOCTOR_MARKDOWN)" RUN_MANIFEST_JSON="$(RUN_MANIFEST_JSON)" RUN_MANIFEST_MARKDOWN="$(RUN_MANIFEST_MARKDOWN)"

