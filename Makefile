preflight-quality-inputs:
	test -n "$(QUALITY_INPUT_PREFLIGHT_CORPUS)"
	test -n "$(QUALITY_INPUT_PREFLIGHT_QUERIES_JSON)"
	test -n "$(QUALITY_INPUT_PREFLIGHT_QRELS_JSON)"
	python3 tools/preflight_quality_inputs.py $(QUALITY_INPUT_PREFLIGHT_CORPUS_ARGS) --queries-json "$(QUALITY_INPUT_PREFLIGHT_QUERIES_JSON)" --qrels-json "$(QUALITY_INPUT_PREFLIGHT_QRELS_JSON)" $(QUALITY_INPUT_PREFLIGHT_OPTIONAL_ARGS)
# Opt-in structural validator for one synthetic quality attempt identity
# envelope. Never invoked by verify, eval-quality, or run finalization.
doctor-quality-attempt-identity:
	test -n "$(QUALITY_ATTEMPT_IDENTITY_JSON)"
	python3 tools/doctor_quality_attempt_identity.py --input-json "$(QUALITY_ATTEMPT_IDENTITY_JSON)" $(QUALITY_ATTEMPT_IDENTITY_OUTPUTS)

eval-quality:
	python3 tools/eval_quality.py $(QUALITY_FIXTURE_ARG) $(QUALITY_QUERY_TIMEOUT_ARG) $(QUERY_STATEMENT_TIMEOUT_ARG) $(QUALITY_OUTPUTS)

eval-quality-budget:
	test -n "$(ANALYSIS_MAX_ITERATIONS)"
	test -n "$(ANALYSIS_MAX_QUERIES)"
	test -n "$(ANALYSIS_DEADLINE_SECONDS)"
	python3 tools/eval_quality.py $(QUALITY_FIXTURE_ARG) --max-iterations "$(ANALYSIS_MAX_ITERATIONS)" --max-queries "$(ANALYSIS_MAX_QUERIES)" --deadline-seconds "$(ANALYSIS_DEADLINE_SECONDS)" $(QUALITY_QUERY_TIMEOUT_ARG) $(QUERY_STATEMENT_TIMEOUT_ARG) $(ANALYSIS_BUDGET_STATUS_ARG) $(QUALITY_OUTPUTS)

eval-public-warc-quality: public-warc-quality-fixture
	QUALITY_FIXTURE="$(PUBLIC_WARC_QUALITY_FIXTURE)" $(MAKE) eval-quality

smoke-public-warc:
	python3 tools/smoke_public_warc.py

build-pg-version:
	docker build --build-arg PG_MAJOR=$(PG_MAJOR) --build-arg DEV_PERMISSIONS=$(PG_DEV_PERMISSIONS) --tag $(PG_IMAGE) .

smoke-pg-version: build-pg-version
	@set -e; \
	container="$(PG_MATRIX_CONTAINER)"; \
	docker rm -f "$$container" >/dev/null 2>&1 || true; \
	trap 'docker rm -f "$$container" >/dev/null 2>&1 || true' EXIT; \
	docker run -d --name "$$container" \
		-e POSTGRES_USER="$(PG_MATRIX_USER)" \
		-e POSTGRES_PASSWORD="$(PG_MATRIX_PASSWORD)" \
		-e POSTGRES_DB="$(PG_MATRIX_DB)" \
		$(PG_IMAGE) >/dev/null; \
	timeout 90 bash -c "until docker exec $$container pg_isready -U $(PG_MATRIX_USER) -d $(PG_MATRIX_DB) >/dev/null 2>&1; do sleep 2; done"; \
	docker exec "$$container" psql -U "$(PG_MATRIX_USER)" -d "$(PG_MATRIX_DB)" -v ON_ERROR_STOP=1 -c 'CREATE EXTENSION pgwarc_lance; SELECT hello_pgwarc_lance();'; \
	docker rm -f "$$container" >/dev/null; \
	trap - EXIT; \
	printf 'smoke passed for PostgreSQL %s\n' "$(PG_MAJOR)"

pg-version-matrix:
	@set -e; \
	for version in $(PG_MATRIX); do \
		$(MAKE) PG_MAJOR=$$version smoke-pg-version; \
	done

check-release-artifacts:
	python3 tools/check_release_artifacts.py --dist-dir "$(DIST_DIR)" --version "$(EXT_VERSION)" --pg-major "$(PG_MAJOR)"

smoke-release-artifacts: check-release-artifacts
	python3 tools/smoke_release_artifacts.py --dist-dir "$(DIST_DIR)" --version "$(EXT_VERSION)" --pg-major "$(PG_MAJOR)" --postgres-image "$(ARTIFACT_SMOKE_IMAGE)" --container-name "$(ARTIFACT_SMOKE_CONTAINER)" --user "$(PG_MATRIX_USER)" --password "$(PG_MATRIX_PASSWORD)" --database "$(PG_MATRIX_DB)" --startup-timeout "$(ARTIFACT_SMOKE_TIMEOUT)"

smoke-release-upgrade:
	test -n "$(UPGRADE_OLD_VERSION)"
	test -n "$(UPGRADE_OLD_DIST_DIR)"
	python3 tools/smoke_release_upgrade.py --old-dist-dir "$(UPGRADE_OLD_DIST_DIR)" --old-version "$(UPGRADE_OLD_VERSION)" --new-dist-dir "$(UPGRADE_NEW_DIST_DIR)" --new-version "$(UPGRADE_NEW_VERSION)" --pg-major "$(PG_MAJOR)" --postgres-image "$(ARTIFACT_SMOKE_IMAGE)" --container-name "$(ARTIFACT_UPGRADE_CONTAINER)" --user "$(PG_MATRIX_USER)" --password "$(PG_MATRIX_PASSWORD)" --database "$(PG_MATRIX_DB)" --startup-timeout "$(ARTIFACT_SMOKE_TIMEOUT)"

doctor-release-upgrade-inputs:
	python3 tools/doctor_release_upgrade_inputs.py --pg-major "$(PG_MAJOR)" --new-version "$(EXT_VERSION)" $(UPGRADE_INPUT_OLD_VERSION_ARG) $(UPGRADE_INPUT_OLD_DIST_DIR_ARG) $(UPGRADE_INPUT_NEW_DIST_DIR_ARG) $(UPGRADE_INPUT_DOCTOR_OUTPUTS)

release-artifacts-matrix:
	@set -e; \
	for version in $(PG_MATRIX); do \
		$(MAKE) PG_MAJOR=$$version release-artifacts; \
	done

smoke-release-artifacts-matrix:
	@set -e; \
	for version in $(PG_MATRIX); do \
		$(MAKE) PG_MAJOR=$$version smoke-release-artifacts; \
	done

smoke-release-upgrade-matrix:
	test -n "$(UPGRADE_OLD_VERSION)"
	@set -e; \
	for version in $(PG_MATRIX); do \
		$(MAKE) PG_MAJOR=$$version smoke-release-upgrade; \
	done

report-release-artifacts:
	python3 tools/report_release_artifacts.py --pg-majors "$(PG_MATRIX)" --version "$(EXT_VERSION)" $(RELEASE_MATRIX_OUTPUTS)

report-release-smoke-matrix:
	@if [ "$(RELEASE_SMOKE_TARGET)" = "smoke-release-upgrade" ]; then \
		$(MAKE) report-release-upgrade-smoke-matrix RELEASE_SMOKE_JSON="$(RELEASE_SMOKE_JSON)" RELEASE_SMOKE_MARKDOWN="$(RELEASE_SMOKE_MARKDOWN)"; \
	else \
		python3 tools/report_release_smoke_matrix.py --pg-majors "$(PG_MATRIX)" --make-program "$(RELEASE_SMOKE_MAKE_PROGRAM)" --make-target "$(RELEASE_SMOKE_TARGET)" --output-tail-lines "$(RELEASE_SMOKE_OUTPUT_LINES)" $(RELEASE_SMOKE_MAKE_VAR_ARGS) $(RELEASE_SMOKE_OUTPUTS); \
	fi

report-release-upgrade-smoke-matrix:
	python3 tools/report_release_upgrade_smoke_matrix.py --pg-majors "$(PG_MATRIX)" --make-program "$(RELEASE_SMOKE_MAKE_PROGRAM)" --make-target "$(RELEASE_SMOKE_TARGET)" --dist-root "$(CURDIR)/dist" --new-version "$(EXT_VERSION)" --output-tail-lines "$(RELEASE_SMOKE_OUTPUT_LINES)" $(RELEASE_SMOKE_MAKE_VAR_ARGS) $(RELEASE_SMOKE_OUTPUTS)

finalize-release-run:
	test -n "$(RUN_DIR)"
	mkdir -p "$(RUN_DIR)"
	$(MAKE) report-release-artifacts RELEASE_MATRIX_JSON="$(RELEASE_RUN_ARTIFACTS_JSON)" RELEASE_MATRIX_MARKDOWN="$(RELEASE_RUN_ARTIFACTS_MARKDOWN)"
	$(MAKE) report-release-smoke-matrix RELEASE_SMOKE_JSON="$(RELEASE_RUN_SMOKE_JSON)" RELEASE_SMOKE_MARKDOWN="$(RELEASE_RUN_SMOKE_MARKDOWN)"
	$(MAKE) finalize-run-directory RUN_DIR="$(RUN_DIR)" RUN_METADATA_COMMAND="$(RELEASE_RUN_METADATA_COMMAND)" RUN_METADATA_ENV="$(RUN_METADATA_ENV)" RUN_METADATA_JSON="$(RUN_METADATA_JSON)" RUN_METADATA_MARKDOWN="$(RUN_METADATA_MARKDOWN)" RUN_DOCTOR_PROFILE=packaging RUN_DOCTOR_REQUIRE="$(RUN_DOCTOR_REQUIRE)" RUN_DOCTOR_JSON="$(RUN_DOCTOR_JSON)" RUN_DOCTOR_MARKDOWN="$(RUN_DOCTOR_MARKDOWN)" RUN_MANIFEST_JSON="$(RUN_MANIFEST_JSON)" RUN_MANIFEST_MARKDOWN="$(RUN_MANIFEST_MARKDOWN)"

doctor-import-summary:
	test -n "$(IMPORT_SUMMARY)"
	python3 tools/doctor_import_summary.py --summary-json "$(IMPORT_SUMMARY)" $(IMPORT_DOCTOR_OUTPUTS)

finalize-import-run:
	test -n "$(RUN_DIR)"
	test -n "$(IMPORT_SUMMARY)"
	mkdir -p "$(RUN_DIR)"
	if [ "$(IMPORT_SUMMARY)" != "$(IMPORT_RUN_SUMMARY)" ]; then cp "$(IMPORT_SUMMARY)" "$(IMPORT_RUN_SUMMARY)"; fi
	$(MAKE) doctor-import-summary IMPORT_SUMMARY="$(IMPORT_RUN_SUMMARY)" IMPORT_DOCTOR_JSON="$(IMPORT_RUN_DOCTOR_JSON)" IMPORT_DOCTOR_MARKDOWN="$(IMPORT_RUN_DOCTOR_MARKDOWN)"
	$(MAKE) finalize-run-directory RUN_DIR="$(RUN_DIR)" RUN_METADATA_COMMAND="$(IMPORT_RUN_METADATA_COMMAND)" RUN_METADATA_ENV="$(RUN_METADATA_ENV)" RUN_METADATA_JSON="$(RUN_METADATA_JSON)" RUN_METADATA_MARKDOWN="$(RUN_METADATA_MARKDOWN)" RUN_DOCTOR_PROFILE=import RUN_DOCTOR_REQUIRE="$(strip $(IMPORT_RUN_DOCTOR_REQUIRE) $(RUN_DOCTOR_REQUIRE))" RUN_DOCTOR_JSON="$(RUN_DOCTOR_JSON)" RUN_DOCTOR_MARKDOWN="$(RUN_DOCTOR_MARKDOWN)" RUN_MANIFEST_JSON="$(RUN_MANIFEST_JSON)" RUN_MANIFEST_MARKDOWN="$(RUN_MANIFEST_MARKDOWN)"

report-run-directory:
	test -n "$(RUN_DIR)"
	test -d "$(RUN_DIR)"
	python3 tools/report_run_directory.py --run-dir "$(RUN_DIR)" $(RUN_MANIFEST_OUTPUTS)

write-run-metadata:
	test -n "$(RUN_DIR)"
	mkdir -p "$(RUN_DIR)"
	python3 tools/write_run_metadata.py --run-dir "$(RUN_DIR)" $(RUN_METADATA_COMMAND_ARG) $(RUN_METADATA_ENV_ARGS) $(RUN_METADATA_OUTPUTS)

doctor-run-directory:
	test -n "$(RUN_DIR)"
	test -d "$(RUN_DIR)"
	python3 tools/doctor_run_directory.py --run-dir "$(RUN_DIR)" --profile "$(RUN_DOCTOR_PROFILE)" $(RUN_DOCTOR_REQUIRE_ARGS) $(RUN_DOCTOR_OUTPUTS)

finalize-run-directory:
	test -n "$(RUN_DIR)"
	mkdir -p "$(RUN_DIR)"
	$(MAKE) write-run-metadata RUN_DIR="$(RUN_DIR)" RUN_METADATA_COMMAND="$(RUN_METADATA_COMMAND)" RUN_METADATA_ENV="$(RUN_METADATA_ENV)" RUN_METADATA_JSON="$(RUN_METADATA_JSON)" RUN_METADATA_MARKDOWN="$(RUN_METADATA_MARKDOWN)"
	$(MAKE) report-run-directory RUN_DIR="$(RUN_DIR)" RUN_MANIFEST_JSON="$(RUN_MANIFEST_JSON)" RUN_MANIFEST_MARKDOWN="$(RUN_MANIFEST_MARKDOWN)"
	$(MAKE) doctor-run-directory RUN_DIR="$(RUN_DIR)" RUN_DOCTOR_PROFILE="$(RUN_DOCTOR_PROFILE)" RUN_DOCTOR_REQUIRE="$(RUN_DOCTOR_REQUIRE)" RUN_DOCTOR_JSON="$(RUN_DOCTOR_JSON)" RUN_DOCTOR_MARKDOWN="$(RUN_DOCTOR_MARKDOWN)"
	$(MAKE) report-run-directory RUN_DIR="$(RUN_DIR)" RUN_MANIFEST_JSON="$(RUN_MANIFEST_JSON)" RUN_MANIFEST_MARKDOWN="$(RUN_MANIFEST_MARKDOWN)"

release-artifacts: build-pg-version
	mkdir -p $(DIST_DIR)
	docker rm -f $(ARTIFACT_CONTAINER) >/dev/null 2>&1 || true
	docker create --name $(ARTIFACT_CONTAINER) $(PG_IMAGE) >/dev/null
	docker cp $(ARTIFACT_CONTAINER):/usr/lib/postgresql/$(PG_MAJOR)/lib/pgwarc_lance.so $(DIST_DIR)/
	docker cp $(ARTIFACT_CONTAINER):/usr/share/postgresql/$(PG_MAJOR)/extension/pgwarc_lance.control $(DIST_DIR)/
	docker cp $(ARTIFACT_CONTAINER):/usr/share/postgresql/$(PG_MAJOR)/extension/pgwarc_lance--$(EXT_VERSION).sql $(DIST_DIR)/
	docker rm $(ARTIFACT_CONTAINER) >/dev/null
	cp LICENSE NOTICE $(DIST_DIR)/
	cp sql/pgwarc_lance--*--*.sql sql/pgwarc_lance-restrict-access.sql $(DIST_DIR)/
	$(MAKE) check-release-artifacts
	@printf 'wrote %s\n' "$(DIST_DIR)"

clean:
	docker compose down -v

.PHONY: test-uri-policy
# Pure filesystem containment tests; no PostgreSQL or running database required.
test-uri-policy:
	@set -eu; output=$$(mktemp /tmp/pgwarc-uri-policy.XXXXXX); trap 'rm -f "$$output"' EXIT; rustc --edition=2021 --test src/uri_policy.rs -o "$$output"; "$$output"

